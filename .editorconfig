root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_prefer_braces = true:warning
dotnet_diagnostic.CA1062.severity = none
# CA1848/CA1873: LoggerMessage delegates are unnecessary micro-optimisation at this scale.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# CA1716: VB-interop keyword clashes are irrelevant for this C#-only solution.
dotnet_diagnostic.CA1716.severity = none

[*.{ts,tsx,js,jsx,json,yml,yaml,css}]
indent_size = 2

[*.{csproj,props,targets,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# EF Core-generated migrations are generated code; exempt from style analysis.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0130.severity = none
dotnet_diagnostic.CA1861.severity = none