# Copy to .env and fill in real values. NEVER commit a filled-in .env.

# PostgreSQL (used by docker-compose)
POSTGRES_DB=guess43
POSTGRES_USER=guess43
POSTGRES_PASSWORD=change-me-strong-password

# JWT signing key — must be a long, random secret (>= 32 bytes).
# Generate one, e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-value

# Optional overrides
# ASPNETCORE_ENVIRONMENT=Production
